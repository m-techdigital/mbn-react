VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_APP_NAME=MuaBanNick.Pro

# mock: UI demo, api: backend only, auto: API read with mock fallback
VITE_DATA_MODE=api
# Loading and motion
VITE_FULL_SCREEN_LOADING=true
VITE_INITIAL_LOADING_MS=850
VITE_ROUTE_OVERLAY_DELAY_MS=120
VITE_ROUTE_OVERLAY_MIN_MS=420
VITE_HOME_MOCK_LOADING_MS=0

VITE_ROUTE_OVERLAY_MAX_MS=6000

# Hiển thị tài khoản kiểm thử nhanh ở hộp thoại đăng nhập
VITE_SHOW_DEMO_ACCOUNTS=false
